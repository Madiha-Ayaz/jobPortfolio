# =============================================================================
# Environment variables template
# =============================================================================
# Copy this file to ".env" (same folder as package.json) and fill in the values.
#   cp .env.example .env
#
# Rules (Vite):
#   - Variables exposed to the CLIENT (browser) MUST start with `VITE_`.
#   - Do NOT wrap values in quotes.
#   - Do NOT commit your real `.env` file (it is already in .gitignore).
#   - After editing `.env`, RESTART the dev server so Vite re-reads the file.
#
# ALL keys used by this project are listed below.
# The full explanation table lives in README.md -> "Required Environment Variables".
# =============================================================================


# -----------------------------------------------------------------------------
# Firebase (client-side, used by src/lib/firebase.ts)
# -----------------------------------------------------------------------------
# Get these from the Firebase Console:
#   Project settings  ->  General  ->  Your apps  ->  SDK setup and configuration
#   (choose the "Config" radio button, not the CDN snippet)
# -----------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# Optional, only if you use Google Analytics for Firebase:
VITE_FIREBASE_MEASUREMENT_ID=


# -----------------------------------------------------------------------------
# Nova AI backend URL (client-side, read by src/utils/api.ts)
# -----------------------------------------------------------------------------
# Where the AI server (server/index.ts) is hosted.
#   - Local dev:      leave empty (defaults to http://localhost:3001)
#   - Deployed site:  set to your live backend URL, e.g.
#                       VITE_API_BASE_URL=https://nova-ai-backend.onrender.com
#   - Same-origin:    set to "" and serve /api from the same domain.
# -----------------------------------------------------------------------------

VITE_API_BASE_URL=

# Default AI model used by the client when the server sends none (optional).
VITE_OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free


# -----------------------------------------------------------------------------
# Server port (server-side, used by server/index.ts)
# -----------------------------------------------------------------------------
# Port the AI backend listens on. Default is 3001.
# -----------------------------------------------------------------------------

PORT=3001


# -----------------------------------------------------------------------------
# OpenRouter API (server-side, used by server/lib/config.ts for the AI chatbot)
# -----------------------------------------------------------------------------
# Get your key at https://openrouter.ai/keys
# This single key gives you access to Gemini, GPT, Claude, Llama, Mistral,
# and many more models through one OpenAI-compatible API.
# It does NOT need the VITE_ prefix because it is read by the server, not
# the browser.
# -----------------------------------------------------------------------------

OPENROUTER_API_KEY=your_openrouter_api_key_here
# Default model (free Gemini). Change to any model on openrouter.ai/models
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# Custom endpoint (optional, only override if you self-host a proxy)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


# -----------------------------------------------------------------------------
# xAI Grok API (server-side, ALTERNATIVE to OpenRouter)
# -----------------------------------------------------------------------------
# Get your key at https://console.x.ai (or platform.x.ai)
# If GROK_API_KEY is set, the AI uses Grok instead of OpenRouter.
# XAI_API_KEY is accepted as an alias if GROK_API_KEY is empty.
# Example models: grok-3-mini, grok-3, grok-4-mini
# -----------------------------------------------------------------------------

GROK_API_KEY=your_grok_api_key_here
# XAI_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-3-mini
# Custom endpoint (optional, only override if you self-host a proxy)
GROK_BASE_URL=https://api.x.ai/v1


# -----------------------------------------------------------------------------
# AI timeout (server-side, optional)
# -----------------------------------------------------------------------------
# How long the server waits for an AI response before timing out (milliseconds).
# Default is 30000.
# -----------------------------------------------------------------------------

AI_TIMEOUT_MS=30000


# -----------------------------------------------------------------------------
# Neon (PostgreSQL) database (server-side, used by server/lib/db.ts)
# -----------------------------------------------------------------------------
# Stores all app data: AI chat messages, session open/close times, page views,
# project opens, contact form submissions, and project-finder searches.
# Get a connection string from https://neon.tech (dashboard -> Connection details).
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Set DATABASE_SSL=true if your DATABASE_URL lacks ?sslmode=require (recommended).
DATABASE_SSL=true
